# Environment Variables Template
# Copy this file to .env and fill in your actual API keys
# cp .env.example .env

# Notion Integration
NOTION_API_KEY=ntn_your_notion_integration_token
NOTION_DATABASE_VIDEO_TREND_ID=your_video_trend_database_id
NOTION_DATASOURCE_VIDEO_TREND_ID=your_video_trend_datasource_id
NOTION_DATABASE_SHORT_VIDEO_SCRIPT_ID=your_short_video_script_database_id

# OpenRouter API (LLM calls)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_data_api_key

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID='your_chat_id'

# DownSub (YouTube subtitle extraction)
DOWNSUB_API_KEY=your_downsub_api_key

# HeyGen (AI avatar video)
HEYGEN_API_KEY=sk_V2_your_heygen_key

# MiniMax TTS
MINIMAX_API_KEY=sk-api-your_minimax_key

# 79ai Grok Video API
GOMMO_ACCESS_TOKEN=your_gommo_access_token
GOMMO_DOMAIN=79ai.net

# AI33 (Nano Banana Pro image generation)
AI33_KEY=sk_your_ai33_key

# Apify (web scraping actors)
APIFY_API_TOKEN=apify_api_your_apify_token

# VBee TTS
VBEE_API=your_vbee_jwt_token
VBEE_APP_ID=your_vbee_app_id

# ElevenLabs TTS (Hoang's brand voice)
ELEVENLABS_VOICE_ID=your_voice_id
ELEVENLABS_API_KEY=sk_your_elevenlabs_key

# xAI Grok (X.com trending posts) — referenced by CLAUDE.md
XAI_API_KEY=xai-your_xai_key
